# Logos Iris — template seguro (sem valores reais). Copie para .env.local e preencha.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Admin hardcoded (ADR-030) — auth.uid() do usuário Supabase do Vinicius.
# Sem tabela de roles nesta fase; migrar para admin_users quando houver 2º admin.
ADMIN_USER_ID=00000000-0000-0000-0000-000000000000

# WhatsApp Gateway — provedores self-hosted (adapters em src/adapters/whatsapp/).
# Gap encontrado no hardening fase 9: estas vars já eram lidas pelo código (evolution.adapter.ts,
# openwa.adapter.ts, route.ts) mas não estavam documentadas aqui — risco real de subir pra produção
# sem elas configuradas e ninguém perceber pelo template.
EVOLUTION_API_BASE_URL=https://your-evolution-instance.example.com
OPENWA_API_BASE_URL=https://your-openwa-instance.example.com

# WhatsApp Cloud API (Meta) — provedor oficial (add-on premium).
META_ACCESS_TOKEN=your_meta_cloud_api_access_token_here
META_PHONE_NUMBER_ID=your_meta_phone_number_id_here
# App Secret do app Meta — usado só pra validar a assinatura nativa X-Hub-Signature-256 (HMAC do
# corpo bruto) no webhook de cloud_api. Preferível ao segredo compartilhado abaixo quando disponível
# (assinatura por-requisição, não segredo estático). Sem esta var, cloud_api cai no fallback do
# WHATSAPP_WEBHOOK_SECRET compartilhado (mesma política de evolution/openwa self-hosted).
META_APP_SECRET=your_meta_app_secret_here

# Segredo compartilhado do webhook (evolution/openwa self-hosted; fallback de cloud_api sem
# META_APP_SECRET). Hardening fase 9: o endpoint agora é FAIL-CLOSED por padrão — sem esta var
# configurada em produção, toda requisição é rejeitada (401), não liberada.
WHATSAPP_WEBHOOK_SECRET=your_shared_webhook_secret_here
# Escape hatch explícito SÓ para dev local sem WHATSAPP_WEBHOOK_SECRET/META_APP_SECRET configurados.
# NUNCA setar "true" em produção — deixar ausente/false mantém o fail-closed.
WHATSAPP_WEBHOOK_ALLOW_INSECURE_DEV=false

# Rate limit do endpoint webhook — janela deslizante em memória (limitação single-instance/
# serverless documentada em src/lib/whatsapp-gateway/rate-limiter.ts). Opcionais: caem nos defaults
# abaixo se omitidas.
WHATSAPP_WEBHOOK_RATE_LIMIT_MAX=30
WHATSAPP_WEBHOOK_RATE_LIMIT_WINDOW_MS=10000
